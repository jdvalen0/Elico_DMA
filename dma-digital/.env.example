# Ejemplo de archivo .env
# Copia este archivo a .env y ajusta los valores

# Base de datos
POSTGRES_PORT=5432

# Backend
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
NODE_ENV=development

# Frontend
# Desarrollo local: http://localhost:3001/api
# Producción: IP o dominio del servidor backend (obligatorio si el navegador
# no está en la misma máquina), p. ej. http://IP_DEL_SERVIDOR:3001/api
VITE_API_URL=http://localhost:3001/api

# Opcional
MINIO_ENABLED=false
